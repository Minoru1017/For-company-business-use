# Hugging Face Read Token（本機 Faster-Whisper 分軌模型授權用）
# 複製此檔為 .env 後填入，勿提交 .env 至 Git
# 取得：https://huggingface.co/settings/tokens
# 授權：https://huggingface.co/pyannote/speaker-diarization-community-1

HF_TOKEN=hf_在這裡貼上你的token

# Azure Speech（僅在使用「Azure 雲端轉錄」時需要）
# 建立資源：https://portal.azure.com → Speech 服務
# 區域範例：eastasia（東亞）、southeastasia（東南亞）

AZURE_SPEECH_KEY=在這裡貼上Azure_Speech金鑰
AZURE_SPEECH_REGION=eastasia
