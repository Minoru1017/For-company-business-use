# Call Coach 本機助手設定（複製此檔為 .env 後填入；勿提交 .env 至 Git）
#
# 兩條路徑擇一即可：
#   A. Azure 雲端轉錄（零門檻，不需 HF Token、不需安裝 WhisperX）：填 AZURE_SPEECH_KEY + AZURE_SPEECH_REGION
#   B. 本機 WhisperX（音訊不上雲）：填 HF_TOKEN，並在網頁按「完整環境安裝」
# 團隊管理者也可改用 team-config.env（同格式）放在助手資料夾，啟動時會自動填入空白欄位。

# Azure Speech（建立資源：https://portal.azure.com → Speech 服務）
# 區域請選有 Fast Transcription 的區域，例如 southeastasia（新加坡）或 japaneast（東京）；
# eastasia（香港）目前沒有 Fast Transcription，會退回較慢的 SDK 模式且需額外安裝。
AZURE_SPEECH_KEY=在這裡貼上Azure_Speech金鑰
AZURE_SPEECH_REGION=southeastasia
# 自訂端點（選填，通常留空）：
# AZURE_SPEECH_ENDPOINT=https://your-resource.cognitiveservices.azure.com

# Hugging Face Read Token（僅本機 WhisperX 分軌模型授權用）
# 取得：https://huggingface.co/settings/tokens
# 授權：https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=hf_在這裡貼上你的token

# 網頁預設選取的轉錄模式（選填）：local_gpu / remote / azure / standard / fast
# 新竹 GPU 主機只用本機轉錄（不需遠端 Worker）：CALL_COACH_DEFAULT_MODE=local_gpu（或雙擊 start_hsinchu_gpu.cmd）
# 未填時：有 GPU + HF_TOKEN 用 local_gpu，有遠端主機設定用 remote，有 Azure 用 azure，否則 standard
# CALL_COACH_DEFAULT_MODE=local_gpu
# CALL_COACH_PREFER_GPU=1
# 本機 GPU 轉錄 batch（顯存不足可改 4）：CALL_COACH_GPU_BATCH=8
# RTX 50 / WhisperX 結束碼 1 時可試：CALL_COACH_GPU_COMPUTE=int8 或 float32
# CALL_COACH_GPU_MODEL=large-v3

# 遠端主機轉錄（自己的 GPU 電腦，例如家用 RTX 顯卡主機）
# 家用主機：執行 start_worker.cmd 會自動產生 CALL_COACH_WORKER_TOKEN 並顯示網址。
# 公司電腦：把該網址與 Token 填在這裡（或在網頁「遠端主機設定」貼上）。
# 網址走 Tailscale 例：http://100.64.0.2:8766；走 Cloudflare Tunnel 例：https://worker.example.com
# CALL_COACH_WORKER_URL=http://100.64.0.2:8766
# CALL_COACH_WORKER_TOKEN=在這裡貼上Worker視窗顯示的Token
# 家用主機選填：Worker 使用的模型（GPU 預設 large-v3，CPU 預設 medium）與監聽埠（預設 8766）
# CALL_COACH_WORKER_MODEL=large-v3
# CALL_COACH_WORKER_PORT=8766

# 通話錄音一條龍（MicroSIP / 公司分享碟自動 WAV → 轉錄 → Call Coach 詢問是否分析）
# 在錄音完成的 PC 上啟用本機助手並設定分享碟路徑（UNC 例：\\fileserver\recordings\ext101）
# CALL_COACH_RECORDINGS_DIR=\\fileserver\share\MicroSIP\Recordings
# CALL_COACH_RECORDINGS_WATCH=1
# 只處理通話 ≥5 分鐘（秒）：CALL_COACH_RECORDINGS_MIN_SECONDS=300
# 掃描間隔（秒）：CALL_COACH_RECORDINGS_POLL_SECONDS=90
# 轉錄模式（留空＝沿用 CALL_COACH_DEFAULT_MODE）：CALL_COACH_RECORDINGS_MODE=local_gpu
# Azure / 遠端模式需明確同意上傳：CALL_COACH_RECORDINGS_CLOUD_CONSENT=1
