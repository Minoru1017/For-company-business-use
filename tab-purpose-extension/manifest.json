{
  "manifest_version": 3,
  "name": "分頁用途標記",
  "version": "1.3.0",
  "description": "拖入開啟的分頁，依工作、興趣與影視領域整理 16 格網站首頁，並支援 Google 帳號登入。",
  "permissions": ["activeTab", "identity", "identity.email", "scripting", "storage", "tabs"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "標記這個分頁",
    "default_popup": "popup/popup.html"
  },
  "chrome_url_overrides": {
    "newtab": "dashboard/dashboard.html"
  }
}
